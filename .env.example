# .env.example -- copy to .env and fill in real values. Never commit
# the real .env (already gitignored).
#
# LOCAL/PRODUCTION SAFETY BOUNDARY (Phase 1): ACTIVITY_EVENTS_ENVIRONMENT
# is this project's one canonical environment marker (see db_safety.py
# and modules/activity_events/service.py). For ordinary local
# development, set it to "local" AND point DATABASE_URL at the local
# jyotishasha_local database below -- factory.py::create_app() will
# refuse to start if you declare "local" but DATABASE_URL points
# anywhere else (including production). Leave this var UNSET on a real
# deployment; the app never requires it to be "production" for a real
# deployment to start.
ACTIVITY_EVENTS_ENVIRONMENT=local

# Local Postgres only -- NEVER put a production connection string here.
# This exact local db name/host is the only combination
# db_safety.py's local allowlist accepts when ACTIVITY_EVENTS_ENVIRONMENT=local.
DATABASE_URL=postgresql://jyotishasha_dev:your-local-password@localhost:5432/jyotishasha_local

# Auth / secrets -- generate your own local dev values, never reuse
# production secrets locally.
JWT_SECRET_KEY=replace-with-a-local-dev-secret
SECRET_KEY=replace-with-a-local-dev-secret

# Admin dashboard (Next.js Admin BFF -> Flask bridge). Must match the
# frontend's own .env.local ADMIN_BRIDGE_SECRET exactly for local admin
# pages to authenticate against local Flask.
ADMIN_BRIDGE_SECRET=replace-with-a-local-dev-value
ADMIN_USER_IDS=

# Third-party integrations -- fill in only what you actually need
# locally; most features degrade gracefully without these.
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=
