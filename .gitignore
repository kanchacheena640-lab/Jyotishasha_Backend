.venv/
venv/
__pycache__/
*.pyc
.env
*.sqlite3

# Repository Cleanup Audit -- generated / temporary / disposable artifacts.
# Never commit these; the code that produces them recreates the
# directory (via os.makedirs(..., exist_ok=True)) the next time it runs.

# AI Prediction Lab -- timestamped prompt/response snapshots from
# test_love.py (local-only dev script). Directory itself is kept via
# .gitkeep; only the generated runs are ignored.
services/ai_prediction_lab/output/*
!services/ai_prediction_lab/output/.gitkeep

# Per-order debug prompt/GPT-response dumps written by tasks.py and
# modules/love/love_premium_task.py for every report generated.
debug_prompts/

# Generated report/chart output written by summary_api.py and the PDF
# generators -- never the source of truth, always regenerable.
reports/*.pdf
reports/*.png

# One-off local DB/debug exports that have no runtime purpose.
backup.dump
*.dump
*.session.sql
/tables.json
/user notification.json
/report.pdf
/order_1_report.pdf

# P3C -- scripts/l3_local_verify.py's own per-run output (result JSON +
# per-test-file logs) and the N2-N5 phase visual-QA harnesses' generated
# screenshot directories. Regenerated on every local run; never the
# source of truth. Narrowly scoped to the exact generated names only --
# never a broad */ pattern that could hide real source directories.
/.l3-*.json
/.l3-*.log
/.l3-visual/
/.n2-*.json
/.n2-*.log
/.n3-visual/
/.n4-visual/
/.n5-visual/
